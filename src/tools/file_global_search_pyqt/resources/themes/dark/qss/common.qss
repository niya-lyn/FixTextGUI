QMainWindow,
QDialog {
  background-color: #2C2F40;
  color: #e1e1e1;
}

QPushButton,
QToolButton {
  background-color: #595C5F;
  color: #e1e1e1;
}

QPushButton:hover,
QToolButton:hover {
  background-color: #6C757D;
}

QToolButton::menu-indicator {
  image: none;
}

QLabel,
QCheckBox,
QRadioButton {
  color: #e1e1e1;
}

QRadioButton::indicator {
  width: 14px;
  height: 14px;
  border-radius: 8px;
  border: 1px solid #e1e1e1;
  background-color: transparent;
}

QRadioButton::indicator:hover {
  border: 1px solid #ffffff;
}

QRadioButton::indicator:checked {
  background-color: #0078D7;
}

QInput,
QSpinBox,
QLineEdit,
QComboBox {
  color: #bfc7d5;
  background-color: #2C2F3B;
  border: 1px solid #727593;
  padding: 2px;
}

QSpinBox::up-button,
QSpinBox::down-button {
  background-color: #464c5f;
  border: none;
  width: 12px;
}

QSpinBox::up-arrow {
  image: url(":/dark/icons/up.png");
  width: 6px;
  height: 6px;
}

QSpinBox::down-arrow {
  image: url(":/dark/icons/down.png");
  width: 6px;
  height: 6px;
}

QSpinBox::up-arrow:disabled,
QSpinBox::down-arrow:disabled {
  image: none;
}

QMenu {
  background-color: #2C2F3B;
  color: #e1e1e1;
  border: 1px solid #727593;
}

QMenu::item:selected {
  background-color: #0078D7;
  color: #FFFFFF;
}

QMenu::item:disabled {
  color: #777;
}

QMenu::separator {
  height: 1px;
  background: #5c5c5c;
  margin: 3px 0;
}

QListView,
QListWidget {
  background-color: #202331;
  alternate-background-color: #2C2F3B;
  color: #e1e1e1;
  border: 1px solid #727593;
}

QListView::item,
QListWidget::item {
  padding: 2px;
}

QListView::item:hover,
QListWidget::item:hover {
  background-color: #6C757D;
}

QListView::item:selected,
QListWidget::item:selected {
  background-color: #0078D7;
  color: #FFFFFF;
}

QTabWidget::pane {
  border: 1px solid #4f5664;
  background: #2C2F3B;
}

QTabBar::tab {
  background: #464c5f;
  color: #b3b8d3;
  border: 1px solid #727593;
  border-bottom: none;
  padding: 6px 12px;
  margin-right: 2px;
}

QTabBar::tab:hover {
  background: #3A3F4B;
}

QTabBar::tab:selected {
  background: #2C2F3B;
  color: #87adff;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  margin-bottom: -1px;
  border: 1px solid #87adff;
}

QTabWidget::tab-bar {
  alignment: left;
  left: 5px;
}

QCheckBox::indicator {
  width: 16px;
  height: 16px;
  background-color: #202331;
  border: 1px solid #727593;
  border-radius: 2px;
}

QCheckBox::indicator:hover {
  border-color: #82AAFF;
}

QCheckBox::indicator:checked {
  background-color: #6590ed;
  border-color: #6590ed;
  image: url(":/dark/icons/tick.png");
}

QCheckBox::indicator:checked:hover {
  background-color: #9AC0FF;
  border-color: #9AC0FF;
}

QCheckBox::indicator:disabled {
  background-color: #2B3042;
  border-color: #3A3F4B;
}

QCheckBox::indicator:checked:disabled {
  background-color: #3A3F4B;
  border-color: #3A3F4B;
}

QScrollBar:vertical {
  background-color: #2C2F3B;
  width: 14px;
  margin: 14px 0 14px 0;
  border: none;
}

QScrollBar::handle:vertical {
  background-color: #464c5f;
  min-height: 30px;
  border-radius: 3px;
  margin: 2px;
}

QScrollBar::handle:vertical:hover {
  background-color: #6C757D;
}

QScrollBar::handle:vertical:pressed {
  background-color: #82AAFF;
}

QScrollBar::add-line:vertical {
  background-color: #2B3042;
  height: 14px;
  width: 14px;
  subcontrol-position: bottom;
  subcontrol-origin: margin;
  border: none;
}

QScrollBar::sub-line:vertical {
  background-color: #2B3042;
  height: 14px;
  width: 14px;
  subcontrol-position: top;
  subcontrol-origin: margin;
  border: none;
}

QScrollBar::add-line:vertical:hover,
QScrollBar::sub-line:vertical:hover {
  background-color: #3A3F4B;
}

QScrollBar::add-line:vertical:pressed,
QScrollBar::sub-line:vertical:pressed {
  background-color: #82AAFF;
}

QScrollBar::up-arrow:vertical {
  width: 12px;
  height: 12px;
  image: url(":/dark/icons/up.png");
}

QScrollBar::down-arrow:vertical {
  width: 12px;
  height: 12px;
  image: url(":/dark/icons/down.png");
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: none;
}

QScrollBar:horizontal {
  background-color: #2C2F3B;
  height: 14px;
  margin: 0 14px 0 14px;
  border: none;
}

QScrollBar::handle:horizontal {
  background-color: #464c5f;
  min-width: 30px;
  border-radius: 3px;
  margin: 2px;
}

QScrollBar::handle:horizontal:hover {
  background-color: #6C757D;
}

QScrollBar::handle:horizontal:pressed {
  background-color: #82AAFF;
}

QScrollBar::add-line:horizontal {
  background-color: #2B3042;
  width: 14px;
  subcontrol-position: right;
  subcontrol-origin: margin;
  border: none;
}

QScrollBar::sub-line:horizontal {
  background-color: #2B3042;
  width: 14px;
  subcontrol-position: left;
  subcontrol-origin: margin;
  border: none;
}

QScrollBar::add-line:horizontal:hover,
QScrollBar::sub-line:horizontal:hover {
  background-color: #3A3F4B;
}

QScrollBar::add-line:horizontal:pressed,
QScrollBar::sub-line:horizontal:pressed {
  background-color: #82AAFF;
}

QScrollBar::left-arrow:horizontal {
  width: 12px;
  height: 12px;
  image: url(":/dark/icons/left.png");
}

QScrollBar::right-arrow:horizontal {
  width: 12px;
  height: 12px;
  image: url(":/dark/icons/right.png");
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: none;
}

QFrame[class='separator_line'] {
  max-height: 1px;
  border: none;
  background-color: #626e83;
}

QGroupBox {
  border: 1px solid #727593;
  border-radius: 6px;
  margin-top: 5px;
  padding-top: 5px;
}

QGroupBox::title {
  color: #87adff;
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 0 3px;
}
