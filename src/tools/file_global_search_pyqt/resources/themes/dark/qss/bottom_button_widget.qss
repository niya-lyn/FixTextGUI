QScrollArea#pagination_scroll_area {
  border: none;
  background-color: #2C2F40;
}

QWidget#pagination_container_widget {
  background-color: transparent;
}

QWidget#pagination_container_widget QPushButton:hover {
  background-color: #5f687f;
  color: #bfc7d5;
}

QWidget#pagination_container_widget QPushButton:checked {
  background-color: #0d5899;
  color: #ffffff;
  font-weight: bold;
}

QWidget#pagination_container_widget QPushButton:checked:hover {
  background-color: #618fd9;
}

QLabel#match_counter_label {
  font-size: 10pt;
  font-weight: bold;
  border-width: 1px;
  border-style: solid;
  border-radius: 5px;
  padding: 5px;
  border-color: #e1e1e1;
}

QPushButton#save_button {
  background-color: #0d5899;
  color: #ffffff;
  font-weight: bold;
  min-height: 35px;
}

QPushButton#save_button:hover {
  background-color: #106cbd;
}

QPushButton#save_button[highlight="true"] {
  background-color: #ce7132;
  color: black;
}

QPushButton#save_button[highlight="true"]:hover {
  background-color: #ed9256;
  color: black;
}

QLabel#editor_info_label {
  font-size: 8pt;
  margin-right: 4px;
  color: #AAAAAA;
}

QLabel#editor_info_label[highlight="true"] {
  color: #e99055;
}

#dots_label {
  color: #E0E0E0;
  margin: 0 1px;
}

#jump_separator {
  color: #AAAAAA;
  margin-left: 5px;
  margin-right: 5px;
}
