/* 深色主题 */
body {
  color: #fbfbfb;
}

/* 标题 */
h1 { color: #82AAFF; }
h2 { color: #C792EA; }
h3 { color: #89DDFF; }
h4, h5, h6 { color: #A6ACCD; }

/* 正文 */
p, li, ul, ol {
  color: #fbfbfb;
}

/* 链接 */
a {
  color: #80CBC4;
  text-decoration: none;
}
a:hover {
  color: #89DDFF;
  text-decoration: underline;
}

/* 行内代码 */
code {
  background-color: #2F3344;
  color: #C3E88D;
  border-radius: 4px;
  padding: 2px 6px;
}

/* 代码块 */
pre,
code {
  background-color: #403f76;
  color: #fbfbfb;
  border: 1px solid #555;
  border-radius: 4px;
  padding: 4px;
}

/* 引用块 */
blockquote {
  border-left: 4px solid #82AAFF;
  background-color: #252837;
  padding: 0.5em 1em;
  margin: 1em 0;
  color: #676E95;
}

/* 分割线，实际无效…… */
hr {
  border-top: 1px solid #555;
}

/* 表格 */
table {
  border-collapse: collapse;
  width: 100%;
}
th, td {
  border: 1px solid #3A3F4B;
  padding: 8px 12px;
  text-align: left;
}
th {
  background-color: #292D3E;
  color: #82AAFF;
}
tr:nth-child(even) {
  background-color: #252837;
}

/* 列表标记 */
ul { list-style-type: disc; }
ol { list-style-type: decimal; }
li::marker { color: #C792EA; }

/* 粗体和斜体 */
strong { color: #F07178; }
em { color: #C792EA; font-style: italic; }

/* 图片 */
img {
  max-width: 100%;
  border-radius: 6px;
}
