{
  "rules": [
    {
      "pattern": "\\(\\?#.*?\\)",
      "comment": "注释 (?#...)",
      "style": {
        "color": "#676E95",
        "italic": true
      }
    },
    {
      "pattern": "\\\\[dDwWsSbBAZzGpP]",
      "comment": "字符类简写 \\d \\w \\s 等",
      "style": {
        "color": "#FFCB6B",
        "font-weight": 75
      }
    },
    {
      "pattern": "\\\\(?:[^\\dDwWsSbBAZzGpxucE0-7]|\\\\[0-7]{1,3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|c[A-Za-z])",
      "comment": "转义字符 \\n \\t \\x00 等",
      "style": {
        "color": "#80CBC4"
      }
    },
    {
      "pattern": "[\\(\\)]",
      "comment": "括号",
      "style": {
        "color": "#89DDFF"
      }
    },
    {
      "pattern": "\\(\\?(:|=|!|<[=!]|P?<[^>]+>|&[^>]+>|R\\d*|R&[^>]+>|[gimnsx-]+:[^)]*\\))",
      "comment": "特殊分组 (?:) (?=) (?!) 等",
      "style": {
        "color": "#82AAFF",
        "font-weight": 75
      }
    },
    {
      "pattern": "\\[(\\^?)(\\\\.|[^\\\\\\]])*\\]",
      "comment": "字符集 [a-z] [^0-9]",
      "style": {
        "color": "#F78C6C"
      }
    },
    {
      "pattern": "[\\*\\+\\?](?:\\?|\\+)?",
      "comment": "量词 * + ? *? +?",
      "style": {
        "color": "#82AAFF",
        "font-weight": 75
      }
    },
    {
      "pattern": "\\{\\d+(?:,\\d*)?\\}\\??",
      "comment": "范围量词 {n} {n,m}",
      "style": {
        "color": "#82AAFF",
        "font-weight": 75
      }
    },
    {
      "pattern": "[\\^\\$]",
      "comment": "锚点 ^ $",
      "style": {
        "color": "#C3E88D",
        "font-weight": 75
      }
    },
    {
      "pattern": "\\|",
      "comment": "或",
      "style": {
        "color": "#89DDFF",
        "font-weight": 75
      }
    },
    {
      "pattern": "\\.",
      "comment": "通配符",
      "style": {
        "color": "#FFCB6B"
      }
    }
  ]
}
