QMainWindow,
QDialog {
  background-color: #F0F2F4;
  color: #24292e;
}

QPushButton,
QToolButton {
  background-color: #E1E4E8;
  color: #24292e;
}

QPushButton:hover,
QToolButton:hover {
  background-color: #BDBDBD;
}

QToolButton::menu-indicator {
  image: none;
}

QLabel,
QCheckBox,
QRadioButton {
  color: #24292e;
}

QInput,
QSpinBox,
QLineEdit,
QComboBox {
  padding: 2px;
}

QMenu {
  background-color: #F0F0F0;
  color: #24292e;
  border: 1px solid #C9CDD1;
}

QMenu::item:selected {
  background-color: #3D9970;
  color: #FFFFFF;
}

QMenu::item:disabled {
  color: #999999;
}

QMenu::separator {
  height: 1px;
  background: #C9CDD1;
  margin: 3px 0;
}

QListView,
QListWidget {
  background-color: #FFFFFF;
  alternate-background-color: #eaf7f0;
  color: #24292e;
  border: 1px solid #C9CDD1;
}

QListView::item,
QListWidget::item {
  padding: 2px;
}

QListView::item:hover,
QListWidget::item:hover {
  background-color: #D8EDDB;
}

QListView::item:selected,
QListWidget::item:selected {
  background-color: #3D9970;
  color: #FFFFFF;
}

QTabWidget::pane {
  border: 1px solid #C9CDD1;
  background: #FFFFFF;
}

QTabBar::tab {
  background: #E1E4E8;
  color: #57606A;
  border: 1px solid #C9CDD1;
  border-bottom: none;
  padding: 6px 12px;
  margin-right: 2px;
}

QTabBar::tab:hover {
  background: #D0D7DE;
}

QTabBar::tab:selected {
  background: #FFFFFF;
  color: #2E8B57;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  margin-bottom: -1px;
  border: 1px solid #2E8B57;
}

QTabWidget::tab-bar {
  alignment: left;
  left: 5px;
}

QGroupBox {
  border: 1px solid #C9CDD1;
  border-radius: 6px;
  margin-top: 5px;
  padding-top: 5px;
}

QGroupBox::title {
  color: #2E8B57;
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 0 3px;
}
