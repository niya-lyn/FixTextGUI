QScrollArea#pagination_scroll_area {
  border: none;
}

QWidget#pagination_container_widget {
  background-color: transparent;
}

QWidget#pagination_container_widget QPushButton:checked {
  background-color: #1C1F23;
  color: white;
}

QLabel#match_counter_label {
  font-size: 10pt;
  font-weight: bold;
  border-width: 1px;
  border-style: solid;
  border-radius: 5px;
  padding: 5px;
}

QPushButton#save_button {
  background-color: #1C1F23;
  color: white;
  font-weight: bold;
  min-height: 35px;
}

QPushButton#save_button:hover {
  background-color: #6C757D;
}

QPushButton#save_button[highlight="true"] {
  background-color: #ad4343;
}

QPushButton#save_button[highlight="true"]:hover {
  background-color: #bc5555;
}

QLabel#editor_info_label {
  font-size: 8pt;
  margin-right: 4px;
  color: #666;
}

QLabel#editor_info_label[highlight="true"] {
  color: #ec0d0d;
}

#dots_label {
  color: black;
  margin: 0 1px;
}

#jump_separator {
  color: gray;
  margin-left: 5px;
  margin-right: 5px;
}
