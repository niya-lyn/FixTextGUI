QToolTip {
  /* 统一设置 tool_tip 样式，需要加上 border，强制弃用原生的样式 */
  /* 不知道为什么 padding 需要这样用 QApplication 单独设置，否则导航跳转时 padding 会反复变化 */
  color: #202331;
  background-color: #FCFCE3;
  border: 1px solid black;
  padding: 2px;
}

QPushButton {
  min-height: 22px;
}

QPlainTextEdit,
QTextEdit,
QTextBrowser {
  color: #24292e;
  background-color: #FFFFFF;
  border: 1px solid #B8C4C8;
}
