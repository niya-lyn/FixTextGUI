<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/light/icons">
    <file alias="link.png">themes/light/icons/link.png</file>
    <file alias="unlink.png">themes/light/icons/unlink.png</file>
    <file alias="history.png">themes/light/icons/history.png</file>
    <file alias="options.png">themes/light/icons/options.png</file>
    <file alias="refresh.png">themes/light/icons/refresh.png</file>
    <file alias="to-top.png">themes/light/icons/to-top.png</file>
    <file alias="updown.png">themes/light/icons/updown.png</file>
    <file alias="left.png">themes/light/icons/left.png</file>
    <file alias="right.png">themes/light/icons/right.png</file>
    <file alias="enabled.png">themes/light/icons/enabled.png</file>
    <file alias="disabled.png">themes/light/icons/disabled.png</file>
    <file alias="up.png">themes/light/icons/up.png</file>
    <file alias="down.png">themes/light/icons/down.png</file>
    <file alias="tick.png">themes/light/icons/tick.png</file>
  </qresource>
  <qresource prefix="/dark/icons">
    <file alias="link.png">themes/dark/icons/link.png</file>
    <file alias="unlink.png">themes/dark/icons/unlink.png</file>
    <file alias="history.png">themes/dark/icons/history.png</file>
    <file alias="options.png">themes/dark/icons/options.png</file>
    <file alias="refresh.png">themes/dark/icons/refresh.png</file>
    <file alias="to-top.png">themes/dark/icons/to-top.png</file>
    <file alias="updown.png">themes/dark/icons/updown.png</file>
    <file alias="left.png">themes/dark/icons/left.png</file>
    <file alias="right.png">themes/dark/icons/right.png</file>
    <file alias="enabled.png">themes/dark/icons/enabled.png</file>
    <file alias="disabled.png">themes/dark/icons/disabled.png</file>
    <file alias="up.png">themes/dark/icons/up.png</file>
    <file alias="down.png">themes/dark/icons/down.png</file>
    <file alias="tick.png">themes/dark/icons/tick.png</file>
  </qresource>
</RCC>
