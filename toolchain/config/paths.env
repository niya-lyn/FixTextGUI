# FixText T0.2 词库迁移工具链 · 路径配置
#
# 说明：
#   DEFAULT_SRC  —— FixText 源码中的 src 目录（本目录 maps/ 与 config/ 为词库来源）
#   DEFAULT_OUT  —— 迁移产物输出目录（每次运行会重新生成 exported/ flattened/ dictionary/ reports/ logs/）
#   DEFAULT_PHP  —— PHP 可执行文件；留空则按 "配置里的 php → PATH 中的 php → 常见安装路径" 顺序探测
#
# 命令行参数优先级高于本文件：
#   ./run_migration.sh --src <dir> --out <dir> --php <path>

TOOLCHAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

DEFAULT_SRC="$TOOLCHAIN_DIR/../src"
DEFAULT_OUT="$TOOLCHAIN_DIR/../build"
DEFAULT_PHP=""
