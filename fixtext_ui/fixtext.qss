/* ============================================================
   FixText V1 · 共享样式表（由 build_qss.py 自动生成，勿手改）
   令牌来源：fixtext_tokens.py（色彩/字号等与 v3 原型 :root 逐字对应；
   质感层派生常量亦集中于该文件）
   ============================================================ */

QWidget {
    font-family: "Segoe UI","Microsoft YaHei UI","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
    font-size: 14px;
    color: #222831;
    background-color: #F7F8FA;
}

QMainWindow {
    background-color: #F7F8FA;
}

QLabel { background-color: transparent; }

#TopBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #15191F,
        stop:0.55 #15191F,
        stop:1 #070A0E);
    border: none;
    border-bottom: 1px solid rgba(255,255,255,.07);
    min-height: 53px;
    max-height: 53px;
}
#TopBar QLabel {
    background-color: transparent;
    color: #FFFFFF;
}
#Brand {
    color: #FFFFFF;
    background: transparent;
    border: none;
    font-size: 16px;
    font-weight: 700;
    padding: 0 12px;
}
#Brand:hover { color: #FFFFFF; }
#TopAct {
    color: #FFFFFF;
    background: rgba(255,255,255,.14);
    border: none;
    font-size: 15px;
    padding: 0;
    min-width: 34px; max-width: 34px; min-height: 34px; max-height: 34px;
    border-radius: 8px;
}
#TopAct:hover { background: rgba(255,255,255,.22); color: #FFFFFF; }
#TopAct:pressed { background: #333B48; }

#BookChip {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF,
        stop:1 #EEF1F5) !important;
    border: 1px solid rgba(255,255,255,.20);
    border-radius: 17px;
    min-height: 34px; max-height: 34px;
    max-width: 320px;
}
#BookChip:hover {
    background: #FFFFFF !important;
    border: 1px solid #9AA3E2;
}
#BookChip:focus { border: 1px solid #4F59C0; }
#BookChip:pressed { background: #EEF1F5 !important; }
#BookChip QLabel { background: transparent; }
#BcGo {
    color: #6B7585;
    font-size: 11px;
    font-weight: 600;
    padding-left: 9px;
    margin-left: 2px;
    border-left: 1px solid #DDE2EA;
}
#BookChip:hover #BcGo { color: #3F48A2; }
#BcDot {
    border-radius: 999px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6F79D1, stop:1 #3F48A2);
}

#ShelfRow {
    background-color: #FFFFFF;
    border: none;
}
#ShelfRow[separator="true"] {
    border-top: 1px solid #EEF1F5;
}
#ShelfRow:hover {
    background-color: #F7F8FA;
}
#ShelfRow[current="true"] {
    background-color: #EEF0FB;
}
#ShelfAct, #ShelfStatus, #ShelfName {
    background: transparent;
    border: none;
}

#Rail {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #DDE2EA;
    padding: 12px 8px;
}
#RailTitle {
    color: #9AA4B4;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
}
#RailItem {
    color: #4A5363;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid transparent;
    text-align: left;
}
#RailItem #RailLabel {
    color: #4A5363;
    font-size: 14px;
    font-weight: 500;
}
#RailItem #RailIco {
    background: #EEF1F5;
    border-radius: 7px;
    font-size: 13px;
    color: #4A5363;
}
#RailItem:hover { background-color: #EEF0FB; }
#RailItem:pressed { background-color: #DDE2EA; }
#RailItem[active="true"] {
    background-color: #DDE1F6;
    color: #333B83;
    font-weight: 600;
    border: 1px solid #DDE1F6;
}
#RailItem[active="true"] #RailLabel {
    color: #333B83;
    font-weight: 600;
}
#RailItem[active="true"] #RailIco {
    background: #FFFFFF;
    color: #333B83;
}

#RadioDot {
    background: transparent;
    border: 2px solid #C2CAD6;
    border-radius: 7px;
}
#RadioDot[selected="true"] {
    border: 2px solid #4F59C0;
}
#RadioDotInner {
    background: transparent;
    border: none;
    border-radius: 3px;
}
#RadioDot[selected="true"] #RadioDotInner {
    background: #4F59C0;
}

#ProblemRow {
    background: #FFFFFF;
    border: 1px solid #EEF1F5;
    border-radius: 10px;
}
#ProblemRow[selected="true"] {
    background: #EEF0FB;
    border: 1px solid #4F59C0;
}

#ChkTop {
    border-radius: 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #333B83, stop:1 #4F59C0);
}
#ChkTop QLabel {
    color: rgba(255,255,255,0.90);
    font-size: 13px;
    background: transparent;
}
#ChkTop QLabel[role="title"] {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 700;
}
#ChkTop QLabel[role="hint"] {
    color: rgba(255,255,255,0.85);
    font-size: 12px;
}
#Hero QLabel {
    color: rgba(255,255,255,0.90);
    font-size: 13px;
    background: transparent;
}
#Hero QLabel[role="title"] {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 700;
}
#Hero QLabel[role="hint"] {
    color: rgba(255,255,255,0.85);
    font-size: 12px;
}
#ChkTop QLabel[role="stats"] {
    color: rgba(255,255,255,0.92);
}
#ChkTop QProgressBar {
    background: rgba(255,255,255,0.25);
    border: none;
    border-radius: 4px;
}
#ChkTop QProgressBar::chunk {
    background: #FFFFFF;
    border-radius: 4px;
}

#LinkBtn {
    background: transparent;
    border: none;
    color: #333B83;
    font-weight: 600;
    font-size: 11px;
    padding: 3px 6px;
    border-radius: 6px;
}
#LinkBtn:hover {
    background: #DDE1F6;
}

#Content {
    background-color: #F7F8FA;
    border: none;
}
#PageTitle {
    color: #15191F;
    font-size: 24px;
    font-weight: 700;
}
#PageSub {
    color: #4A5363;
    font-size: 16px;
}
#PageHead h1 {
    color: #15191F;
    font-size: 24px;
    font-weight: 700;
}
#TopWhere {
    color: #C2CAD6;
    font-size: 13px;
    padding-left: 12px;
}

#RailIco {
    border-radius: 7px;
    font-size: 13px;
}
#RailLabel {
    font-size: 14px;
}
#RailTag {
    color: #B45309;
    background-color: #FBF1DF;
    border: 1px solid #F0D6A8;
    border-radius: 999px;
    padding: 0 6px;
    font-size: 10px;
    font-weight: 700;
}
#RailTip {
    color: #9AA4B4;
    font-size: 12px;
    padding: 8px 12px 0 12px;
}

#OverviewCard {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 12px;
}
#OverviewCard:hover {
    border-color: #DDE1F6;
    background-color: #EEF0FB;
}
#OvfIco {
    background-color: #EEF0FB;
    border-radius: 8px;
    font-size: 16px;
}

QFrame#Card {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 12px;
}
QWidget#CardHead, QWidget#CardBody {
    background: transparent;
}

QPushButton {
    font-family: "Segoe UI","Microsoft YaHei UI","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
    font-size: 14px;
    font-weight: 500;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
}
QPushButton:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
#BtnPrimary {
    background-color: #4F59C0;
    color: #FFFFFF;
}
#BtnPrimary:hover:!pressed { background-color: #3F48A2; }
#BtnPrimary:pressed { background-color: #333B83; }
#BtnPrimary:disabled { background-color: #9AA3E2; color: #FFFFFF; opacity: 0.5; }
#BtnSecondary {
    background-color: #EEF1F5;
    color: #222831;
}
#BtnSecondary:hover:!pressed { background-color: #DDE2EA; }
#BtnSecondary:pressed { background-color: #C2CAD6; }
#BtnGhost {
    background-color: transparent;
    color: #3F48A2;
}
#BtnGhost:hover:!pressed { background-color: #EEF0FB; }
#BtnGhost:pressed { background-color: #DDE1F6; }

#BtnOutline {
    background-color: #FFFFFF;
    color: #222831;
    border: 1px solid #DDE2EA;
}
#BtnOutline:hover:!pressed { background-color: #EEF0FB; border-color: #DDE1F6; }
#BtnOutline:pressed { background-color: #DDE1F6; }
#BtnDanger {
    background-color: #FFFFFF;
    color: #C0392B;
    border: 1px solid #F1C4BD;
}
#BtnDanger:hover:!pressed { background-color: #FBEAE8; }
#BtnDanger:pressed { background-color: #F1C4BD; }
#BtnSecondary:focus { border: 1px solid #4F59C0; }
#BtnOutline:focus { border: 1px solid #4F59C0; }
#BtnDanger:focus { border: 1px solid #4F59C0; }
#BtnGhost:focus { border: 1px solid #C0C6EE; }
#BtnPrimary:focus { background-color: #3F48A2; }

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #222831;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #4F59C0;
    background-color: #FFFFFF;
}
QLineEdit:disabled, QTextEdit:disabled {
    background-color: #EEF1F5;
    color: #9AA4B4;
}
QComboBox:hover { border: 1px solid #9AA3E2; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    selection-background-color: #EEF0FB;
    selection-color: #333B83;
    outline: 0;
    padding: 4px;
}
QPushButton#HeadIconBtn {
    background-color: #EEF1F5;
    color: #333B48;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    font-size: 15px;
    min-width: 34px; max-width: 34px;
    min-height: 34px; max-height: 34px;
    padding: 0;
}
QPushButton#HeadIconBtn:hover {
    background-color: #EEF0FB;
    color: #333B83;
    border: 1px solid #C0C6EE;
}
QPushButton#HeadIconBtn:pressed {
    background-color: #DDE1F6;
    color: #333B83;
}
QLabel#SafeBadge {
    color: #15803D;
    background-color: #E7F4EC;
    border: 1px solid #B6E0C5;
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 700;
}

QCheckBox {
    color: #333B48;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px; height: 16px;
    border-radius: 4px;
    border: 1px solid #C2CAD6;
    background-color: #FFFFFF;
}
QCheckBox::indicator:checked { background-color: #4F59C0; border-color: #4F59C0; }
QCheckBox::indicator:checked { image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNiIgaGVpZ2h0PSIxNiI+PHBhdGggZD0iTTYgMTEuM2wtMy4zLTMuM2EuOTh4Ljk4IDAgMCAxIDEuNC0xLjRMNiA4LjU5bDUuNi01LjU5YTEuMDEgMS4wMSAwIDEgMSAxLjQxIDEuNDFMNiAxMS4zeiIgZmlsbD0iI2ZmZiIvPjwvc3ZnPg==); }

QTableWidget, QTreeWidget, QListWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F7F8FA;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    gridline-color: #EEF1F5;
    font-size: 13px;
}
QTableWidget::item:hover, QListWidget::item:hover { background-color: #EEF0FB; }
QHeaderView::section {
    background-color: #F7F8FA;
    color: #4A5363;
    border: none;
    border-bottom: 1px solid #DDE2EA;
    padding: 8px 12px;
    font-weight: 600;
}
QTableWidget::item:selected, QListWidget::item:selected { background-color: #EEF0FB; color: #2B3169; }

QFrame#PathRow {
    background-color: #F7F8FA;
    border: 1px dashed #DDE2EA;
    border-radius: 8px;
}

#Badge {
    color: #333B83;
    background-color: #EEF0FB;
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 12px;
}
#TagOk {
    color: #15803D;
    background-color: #E7F4EC;
    border: 1px solid #B6E0C5;
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 12px;
}
#TagWarn {
    color: #B45309;
    background-color: #FBF1DF;
    border: 1px solid #F0D6A8;
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 12px;
}
#TagErr {
    color: #C0392B;
    background-color: #FBEAE8;
    border: 1px solid #F1C4BD;
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 12px;
}

#Pill {
    border-radius: 999px;
    padding: 2px 9px;
    font-size: 12px;
    font-weight: 700;
}
#Pill[kind="ok"] {
    color: #15803D;
    background: #E7F4EC;
}
#Pill[kind="info"] {
    color: #3F48A2;
    background: #ECEEF9;
}
#Pill[kind="warn"] {
    color: #B45309;
    background: #FBF1DF;
}
#Pill[kind="err"] {
    color: #C0392B;
    background: #FBEAE8;
}
#Pill[kind="neutral"] {
    color: #6B7585;
    background: #EEF1F5;
}

#RadioCard {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
}
#RadioCard:hover { border: 1px solid #9AA3E2; }
#RadioCard[selected="true"] {
    background: #EEF0FB;
    border: 1px solid #4F59C0;
}

QLabel#BagChkText {
    color: #222831;
    font-size: 13px;
    spacing: 7px;
}
QFrame#BagChk[on="true"] QLabel#BagChkText {
    color: #333B83;
    font-weight: 600;
}
#BagLockTag {
    color: #FFFFFF;
    padding: 1px 7px;
    font-size: 10px;
    font-weight: 700;
}

QFrame#EmptyState {
    background: #F7F8FA;
    border: 1px dashed #DDE2EA;
    border-radius: 12px;
}
#EsIcoRing {
    background: #EEF0FB;
    border: none;
    border-radius: 36px;
}
#EsIco {
    background: #DDE1F6;
    color: #333B83;
    border-radius: 30px;
    font-size: 26px;
}

#TierTabs {
    background: #EEF1F5;
    border-radius: 999px;
    padding: 3px;
}
#TierTab {
    border-radius: 999px;
    padding: 6px 15px;
    font-weight: 600;
    font-size: 13px;
    background: transparent;
    color: #4A5363;
    border: none;
}
#TierTab:hover {
    background: #F7F8FA;
}
#TierTab[active="true"] {
    background: #FFFFFF;
    color: #333B83;
    border: 1px solid #DDE2EA;
}
#TierTab[active="true"]:hover {
    background: #FFFFFF;
}

#Banner {
    background: #EEF0FB;
    border: 1px solid #DDE1F6;
    border-radius: 12px;
    padding: 14px 18px;
}
#BannerIco {
    background: #4F59C0;
    color: #FFFFFF;
    border-radius: 10px;
    font-size: 18px;
}

#Search {
    background: #F7F8FA;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #222831;
}
#Search:focus {
    border-color: #4F59C0;
    border-width: 2px;
}

#SnapItem {
    border-bottom: 1px solid #EEF1F5;
}

#DictItem {
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    background: #FFFFFF;
}
#DictItem[active="true"] {
    border: 1px solid #4F59C0;
    background: #EEF0FB;
}

#LinkBtn[danger="true"] {
    color: #C0392B;
}
#LinkBtn[danger="true"]:hover {
    background: #FBEAE8;
}

QFrame#MiniTable {
    border: 1px solid #DDE2EA;
    border-radius: 10px;
    background: #FFFFFF;
}

QFrame#BookBar {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 12px;
}
#BookBarIco {
    background: #DDE1F6;
    color: #333B83;
    border-radius: 10px;
    font-size: 19px;
}

#Hero {
    border-radius: 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #333B83, stop:1 #4F59C0);
}
#HeroBtn {
    background: #FFFFFF;
    color: #333B83;
    border: none;
    border-radius: 12px;
    padding: 16px 34px;
    font-size: 16px;
    font-weight: 700;
}
#HeroBtn:hover:!pressed {
    background: #EEF0FB;
}
#HeroBtn:pressed {
    background: #DDE1F6;
}
#HeroBtn:disabled {
    opacity: 0.5;
    background: #FFFFFF;
    color: #4F59C0;
}

#Diff {
    background: #F7F8FA;
    border-radius: 10px;
}
#Stat {
    background: #EEF0FB;
    border-radius: 10px;
}

QComboBox#FmtCombo {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 13px;
    color: #222831;
}
QComboBox#FmtCombo:hover {
    border: 1px solid #9AA3E2;
}
QComboBox#FmtCombo:focus {
    border: 1px solid #4F59C0;
}
QComboBox#FmtCombo::drop-down { border: none; width: 28px; }
QComboBox#FmtCombo QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    selection-background-color: #EEF0FB;
    selection-color: #333B83;
    outline: 0;
    padding: 4px;
}

#WizardPanel {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 12px;
}
#OnbProgress {
    background: #DDE2EA;
    border: none;
    border-radius: 999px;
}
#OnbProgress::chunk {
    background: #4F59C0;
    border-radius: 999px;
}

QLabel#ShelfBadge {
    color: #FFFFFF;
    background-color: #15803D;
    border: none;
    border-radius: 12px;
    padding: 0 10px;
    font-size: 11px;
    font-weight: 600;
}
#BtnSetCurrent {
    color: #333B83;
    background: #EEF0FB;
    border: 1px solid #C0C6EE;
    border-radius: 12px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 600;
    outline: none;
}
#BtnSetCurrent:hover {
    background: #4F59C0;
    color: #FFFFFF;
    border: 1px solid #4F59C0;
}
#BtnSetCurrent:pressed {
    background: #3F48A2;
    color: #FFFFFF;
    border: 1px solid #3F48A2;
}

#Toast {
    background: #222831;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 13px;
}
#UndoBtn {
    background: #4F59C0;
    color: #FFFFFF;
    border: none;
    padding: 6px 12px;
    border-radius: 7px;
    font-weight: 700;
    font-size: 13px;
}
#UndoBtn:hover {
    background: #3F48A2;
}

Line, QFrame[frameShape="4"] {
    background-color: #DDE2EA;
}

QScrollArea, QAbstractScrollArea {
    border: none;
}
QScrollBar:vertical {
    background: #F7F8FA;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #DDE2EA;
    border-radius: 999px;
    min-height: 36px;
}
QScrollBar::handle:vertical:hover { background: #C2CAD6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0; width: 0;
}
QScrollBar:horizontal {
    background: #F7F8FA;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #DDE2EA;
    border-radius: 999px;
    min-width: 36px;
}
QScrollBar::handle:horizontal:hover { background: #C2CAD6; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0; width: 0;
}

QProgressBar {
    background-color: #EEF1F5;
    border-radius: 999px;
    height: 8px;
    text-align: center;
    color: #4A5363;
    font-size: 12px;
}
QProgressBar::chunk { background-color: #4F59C0; border-radius: 999px; }

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    margin-top: 16px;
    padding: 12px;
}
QGroupBox::title {
    color: #333B48;
    font-weight: 600;
    subcontrol-origin: margin;
    left: 12px;
}

QScrollArea#VocabTableScroll {
    background: transparent;
    border: none;
}
QScrollArea#VocabTableScroll > QWidget {
    background: transparent;
}
QWidget#VocabScrollInner {
    background-color: #FFFFFF;
}
QWidget#VocabRow {
    background-color: #FFFFFF;
}
QWidget#VocabRow QWidget {
    background: transparent;
}

QWidget#VocabTableHeader {
    background-color: #EEF1F5;
    border-bottom: 1px solid #DDE2EA;
}

QWidget#CellFullText {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    padding: 4px;
}
QWidget#CellFullText QLabel {
    color: #15191F;
    background: transparent;
}

