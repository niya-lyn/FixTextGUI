/* ============================================================
   FixText V1 · 共享样式表（由 build_qss.py 自动生成，勿手改）
   令牌来源：fixtext_tokens.py（色彩/字号等与 v3 原型 :root 逐字对应；
   质感层派生常量亦集中于该文件）
   ============================================================ */

QWidget {
    font-family: "Segoe UI","Microsoft YaHei UI","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
    font-size: 14px;
    color: #222831;
    background-color: #F7F8FA;
}

QMainWindow {
    background-color: #F7F8FA;
}

QLabel { background-color: transparent; }

#TopBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #15191F,
        stop:0.55 #15191F,
        stop:1 #070A0E);
    border: none;
    border-bottom: 1px solid rgba(255,255,255,.07);
    min-height: 53px;
    max-height: 53px;
}
#TopBar QLabel {
    background-color: transparent;
    color: #FFFFFF;
}
#Brand {
    color: #FFFFFF;
    background: transparent;
    border: none;
    font-size: 16px;
    font-weight: 700;
    padding: 0 12px;
}
#Brand:hover { color: #FFFFFF; }
#TopBar #BrandLogo {
    background-color: #FFFFFF;
    color: #3F48A2;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
}
#TopAct {
    color: #FFFFFF;
    background: rgba(255,255,255,.14);
    border: none;
    font-size: 15px;
    padding: 0;
    min-width: 34px; max-width: 34px; min-height: 34px; max-height: 34px;
    border-radius: 8px;
}
#TopAct:hover { background: rgba(255,255,255,.22); color: #FFFFFF; }
#TopAct:pressed { background: #333B48; }

#BookChip {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF,
        stop:1 #EEF1F5) !important;
    border: 1px solid rgba(255,255,255,.20);
    border-radius: 17px;
    min-height: 34px; max-height: 34px;
    max-width: 320px;
}
#BookChip:hover {
    background: #FFFFFF !important;
    border: 1px solid #9AA3E2;
}
#BookChip:focus { border: 1px solid #4F59C0; }
#BookChip:pressed { background: #EEF1F5 !important; }
#BookChip QLabel { background: transparent; }
#BcGo {
    color: #6B7585;
    font-size: 11px;
    font-weight: 600;
    padding-left: 9px;
    margin-left: 2px;
    border-left: 1px solid #DDE2EA;
}
#BookChip:hover #BcGo { color: #3F48A2; }
#BcDot {
    border-radius: 999px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6F79D1, stop:1 #3F48A2);
}

#ShelfRow {
    background-color: #FFFFFF;
    border: none;
}
#ShelfRow[separator="true"] {
    border-top: 1px solid #EEF1F5;
}
#ShelfRow:hover {
    background-color: #F7F8FA;
}
#ShelfRow[current="true"] {
    background-color: #EEF0FB;
}
#ShelfAct, #ShelfStatus, #ShelfName {
    background: transparent;
    border: none;
}

#Rail {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #DDE2EA;
    padding: 12px 8px;
}
#RailTitle {
    color: #9AA4B4;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
}
#RailItem {
    color: #4A5363;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid transparent;
    text-align: left;
}
#RailItem #RailLabel {
    color: #4A5363;
    font-size: 14px;
    font-weight: 500;
}
#RailItem #RailIco {
    background: #EEF1F5;
    border-radius: 7px;
    font-size: 13px;
    color: #4A5363;
}
#RailItem:hover { background-color: #EEF0FB; }
#RailItem:pressed { background-color: #DDE2EA; }
#RailItem[active="true"] {
    background-color: #DDE1F6;
    color: #333B83;
    font-weight: 600;
    border: 1px solid #DDE1F6;
}
#RailItem[active="true"] #RailLabel {
    color: #333B83;
    font-weight: 600;
}
#RailItem[active="true"] #RailIco {
    background: #FFFFFF;
    color: #333B83;
}

#RadioDot {
    background: transparent;
    border: 2px solid #C2CAD6;
    border-radius: 7px;
}
#RadioDot[selected="true"] {
    border: 2px solid #4F59C0;
}
#RadioDotInner {
    background: transparent;
    border: none;
    border-radius: 3px;
}
#RadioDot[selected="true"] #RadioDotInner {
    background: #4F59C0;
}

#ProblemRow {
    background: #FFFFFF;
    border: 1px solid #EEF1F5;
    border-radius: 10px;
}
#ProblemRow[selected="true"] {
    background: #EEF0FB;
    border: 1px solid #4F59C0;
}

#ChkTop {
    border-radius: 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #333B83, stop:1 #4F59C0);
}
#ChkTop QLabel {
    color: rgba(255,255,255,0.90);
    font-size: 13px;
    background: transparent;
}
#ChkTop QLabel[role="title"] {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 700;
}
#ChkTop QLabel[role="hint"] {
    color: rgba(255,255,255,0.85);
    font-size: 12px;
}
#Hero QLabel {
    color: rgba(255,255,255,0.90);
    font-size: 13px;
    background: transparent;
}
#Hero QLabel[role="title"] {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 700;
}
#Hero QLabel[role="hint"] {
    color: rgba(255,255,255,0.85);
    font-size: 12px;
}
#ChkTop QLabel[role="stats"] {
    color: rgba(255,255,255,0.92);
}
#ChkTop QProgressBar {
    background: rgba(255,255,255,0.25);
    border: none;
    border-radius: 4px;
}
#ChkTop QProgressBar::chunk {
    background: #FFFFFF;
    border-radius: 4px;
}

#LinkBtn {
    background: transparent;
    border: none;
    color: #333B83;
    font-weight: 600;
    font-size: 11px;
    padding: 3px 6px;
    border-radius: 6px;
}
#LinkBtn:hover {
    background: #DDE1F6;
}

#Content {
    background-color: #F7F8FA;
    border: none;
}
#PageTitle {
    color: #15191F;
    font-size: 20px;
    font-weight: 700;
}
#PageSub {
    color: #4A5363;
    font-size: 13px;
}
#PageHead h1 {
    color: #15191F;
    font-size: 20px;
    font-weight: 700;
}
#TopWhere {
    color: #C2CAD6;
    font-size: 13px;
    padding-left: 12px;
}

#RailIco {
    border-radius: 7px;
    font-size: 13px;
}
#RailLabel {
    font-size: 14px;
}
#RailTag {
    color: #B45309;
    background-color: #FBF1DF;
    border: 1px solid #F0D6A8;
    border-radius: 999px;
    padding: 0 6px;
    font-size: 10px;
    font-weight: 700;
}
#RailTip {
    color: #9AA4B4;
    font-size: 12px;
    padding: 8px 12px 0 12px;
}

#OverviewCard {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 12px;
}
#OverviewCard:hover {
    border-color: #DDE1F6;
    background-color: #EEF0FB;
}
#OvfIco {
    background-color: #DDE1F6;
    border-radius: 12px;
    font-size: 16px;
}

QFrame#Card {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 12px;
}
QWidget#CardHead, QWidget#CardBody {
    background: transparent;
}

QPushButton {
    font-family: "Segoe UI","Microsoft YaHei UI","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
    font-size: 14px;
    font-weight: 500;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
}
QPushButton:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
#BtnPrimary {
    background-color: #4F59C0;
    color: #FFFFFF;
}
#BtnPrimary:hover:!pressed { background-color: #3F48A2; }
#BtnPrimary:pressed { background-color: #333B83; }
#BtnPrimary:disabled { background-color: #9AA3E2; color: #FFFFFF; opacity: 0.5; }
#BtnSecondary {
    background-color: #EEF1F5;
    color: #222831;
}
#BtnSecondary:hover:!pressed { background-color: #DDE2EA; }
#BtnSecondary:pressed { background-color: #C2CAD6; }
#BtnGhost {
    background-color: transparent;
    color: #3F48A2;
}
#BtnGhost:hover:!pressed { background-color: #EEF0FB; }
#BtnGhost:pressed { background-color: #DDE1F6; }

#BtnOutline {
    background-color: #FFFFFF;
    color: #222831;
    border: 1px solid #DDE2EA;
}
#BtnOutline:hover:!pressed { background-color: #EEF0FB; border-color: #DDE1F6; }
#BtnOutline:pressed { background-color: #DDE1F6; }
#BtnDanger {
    background-color: #FFFFFF;
    color: #C0392B;
    border: 1px solid #F1C4BD;
}
#BtnDanger:hover:!pressed { background-color: #FBEAE8; }
#BtnDanger:pressed { background-color: #F1C4BD; }
#BtnSecondary:focus { border: 1px solid #4F59C0; }
#BtnOutline:focus { border: 1px solid #4F59C0; }
#BtnDanger:focus { border: 1px solid #4F59C0; }
#BtnGhost:focus { border: 1px solid #C0C6EE; }
#BtnPrimary:focus { background-color: #3F48A2; }

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #222831;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #4F59C0;
    background-color: #FFFFFF;
}
QLineEdit:disabled, QTextEdit:disabled {
    background-color: #EEF1F5;
    color: #9AA4B4;
}
QComboBox:hover { border: 1px solid #9AA3E2; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    selection-background-color: #EEF0FB;
    selection-color: #333B83;
    outline: 0;
    padding: 4px;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    padding: 4px 4px;
    outline: 0;
}
QMenu::item {
    background: transparent;
    color: #222831;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #EEF0FB;
    color: #333B83;
}
QMenu::item:disabled {
    color: #9AA4B4;
}
QMenu::separator {
    height: 1px;
    background: #DDE2EA;
    margin: 4px 8px;
}
QPushButton#HeadIconBtn {
    background-color: #EEF1F5;
    color: #333B48;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    font-size: 15px;
    min-width: 34px; max-width: 34px;
    min-height: 34px; max-height: 34px;
    padding: 0;
}
QPushButton#HeadIconBtn:hover {
    background-color: #EEF0FB;
    color: #333B83;
    border: 1px solid #C0C6EE;
}
QPushButton#HeadIconBtn:pressed {
    background-color: #DDE1F6;
    color: #333B83;
}
QLabel#SafeBadge {
    color: #15803D;
    background-color: #E7F4EC;
    border: 1px solid #B6E0C5;
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 700;
}

QCheckBox {
    color: #333B48;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px; height: 16px;
    border-radius: 4px;
    border: 1px solid #C2CAD6;
    background-color: #FFFFFF;
}
QCheckBox::indicator:checked { background-color: #4F59C0; border-color: #4F59C0; }
QCheckBox::indicator:checked { image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNiIgaGVpZ2h0PSIxNiI+PHBhdGggZD0iTTYgMTEuM2wtMy4zLTMuM2EuOTh4Ljk4IDAgMCAxIDEuNC0xLjRMNiA4LjU5bDUuNi01LjU5YTEuMDEgMS4wMSAwIDEgMSAxLjQxIDEuNDFMNiAxMS4zeiIgZmlsbD0iI2ZmZiIvPjwvc3ZnPg==); }

QRadioButton {
    color: #222831;
    spacing: 8px;
    font-size: 13px;
}
QRadioButton::indicator {
    width: 16px; height: 16px;
    border-radius: 8px;
    border: 1px solid #C2CAD6;
    background-color: #FFFFFF;
}
QRadioButton::indicator:checked { background-color: #4F59C0; border-color: #4F59C0; }
QToolTip {
    background-color: #FFFFFF;
    color: #222831;
    border: 1px solid #DDE2EA;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 13px;
}
QTableWidget, QTreeWidget, QListWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F7F8FA;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    gridline-color: #EEF1F5;
    font-size: 13px;
}
QTableWidget::item:hover, QListWidget::item:hover { background-color: #EEF0FB; }
QHeaderView::section {
    background-color: #F7F8FA;
    color: #4A5363;
    border: none;
    border-bottom: 1px solid #DDE2EA;
    padding: 8px 12px;
    font-weight: 600;
}
QTableWidget::item:selected, QListWidget::item:selected { background-color: #EEF0FB; color: #2B3169; }

QFrame#PathRow {
    background-color: #F7F8FA;
    border: 1px dashed #DDE2EA;
    border-radius: 8px;
}

#Badge {
    color: #333B83;
    background-color: #EEF0FB;
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 12px;
}
#TagOk {
    color: #15803D;
    background-color: #E7F4EC;
    border: 1px solid #B6E0C5;
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 12px;
}
#TagWarn {
    color: #B45309;
    background-color: #FBF1DF;
    border: 1px solid #F0D6A8;
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 12px;
}
#TagErr {
    color: #C0392B;
    background-color: #FBEAE8;
    border: 1px solid #F1C4BD;
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 12px;
}

#Pill {
    border-radius: 999px;
    padding: 2px 9px;
    font-size: 12px;
    font-weight: 700;
}
#Pill[kind="ok"] {
    color: #15803D;
    background: #E7F4EC;
}
#Pill[kind="info"] {
    color: #3F48A2;
    background: #ECEEF9;
}
#Pill[kind="warn"] {
    color: #B45309;
    background: #FBF1DF;
}
#Pill[kind="err"] {
    color: #C0392B;
    background: #FBEAE8;
}
#Pill[kind="neutral"] {
    color: #6B7585;
    background: #EEF1F5;
}

#RadioCard {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
}
#RadioCard:hover { border: 1px solid #9AA3E2; }
#RadioCard[selected="true"] {
    background: #EEF0FB;
    border: 1px solid #4F59C0;
}

QLabel#BagChkText {
    color: #222831;
    font-size: 13px;
    spacing: 7px;
}
QFrame#BagChk[on="true"] QLabel#BagChkText {
    color: #333B83;
    font-weight: 600;
}
#BagLockTag {
    color: #FFFFFF;
    padding: 1px 7px;
    font-size: 10px;
    font-weight: 700;
}

QFrame#EmptyState {
    background: #F7F8FA;
    border: 1px dashed #C2CAD6;
    border-radius: 12px;
}
#EsIcoRing {
    background: #EEF0FB;
    border: none;
    border-radius: 36px;
}
#EsIco {
    background: #DDE1F6;
    color: #333B83;
    border-radius: 30px;
    font-size: 26px;
}

#TierTabs {
    background: #EEF1F5;
    border-radius: 999px;
    padding: 3px;
}
#TierTab {
    border-radius: 999px;
    padding: 6px 15px;
    font-weight: 600;
    font-size: 13px;
    background: transparent;
    color: #4A5363;
    border: none;
}
#TierTab:hover {
    background: #F7F8FA;
}
#TierTab[active="true"] {
    background: #FFFFFF;
    color: #333B83;
    border: 1px solid #DDE2EA;
}
#TierTab[active="true"]:hover {
    background: #FFFFFF;
}

#Banner {
    background: #EEF0FB;
    border: 1px solid #DDE1F6;
    border-radius: 12px;
    padding: 14px 18px;
}
#BannerIco {
    background: #4F59C0;
    color: #FFFFFF;
    border-radius: 10px;
    font-size: 18px;
}

#Search {
    background: #F7F8FA;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #222831;
}
#Search:focus {
    border-color: #4F59C0;
    border-width: 2px;
}

#SnapItem {
    border-bottom: 1px solid #EEF1F5;
}

#DictItem {
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    background: #FFFFFF;
}
#DictItem[active="true"] {
    border: 1px solid #4F59C0;
    background: #EEF0FB;
}

#LinkBtn[danger="true"] {
    color: #C0392B;
}
#LinkBtn[danger="true"]:hover {
    background: #FBEAE8;
}

QFrame#MiniTable {
    border: 1px solid #DDE2EA;
    border-radius: 10px;
    background: #FFFFFF;
}

QFrame#BookBar {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 12px;
}
#BookBarIco {
    background: #DDE1F6;
    color: #333B83;
    border-radius: 10px;
    font-size: 19px;
}

#Hero {
    border-radius: 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #333B83, stop:1 #4F59C0);
}
#HeroBtn {
    background: #FFFFFF;
    color: #333B83;
    border: none;
    border-radius: 12px;
    padding: 16px 34px;
    font-size: 16px;
    font-weight: 700;
}
#HeroBtn:hover:!pressed {
    background: #EEF0FB;
}
#HeroBtn:pressed {
    background: #DDE1F6;
}
#HeroBtn:disabled {
    opacity: 0.5;
    background: #FFFFFF;
    color: #4F59C0;
}

#Diff {
    background: #F7F8FA;
    border-radius: 10px;
}
#Stat {
    background: #EEF0FB;
    border-radius: 10px;
}

QComboBox#FmtCombo {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 13px;
    color: #222831;
}
QComboBox#FmtCombo:hover {
    border: 1px solid #9AA3E2;
}
QComboBox#FmtCombo:focus {
    border: 1px solid #4F59C0;
}
QComboBox#FmtCombo::drop-down { border: none; width: 28px; }
QComboBox#FmtCombo QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    selection-background-color: #EEF0FB;
    selection-color: #333B83;
    outline: 0;
    padding: 4px;
}

#WizardPanel {
    background: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 12px;
}
#OnbProgress {
    background: #DDE2EA;
    border: none;
    border-radius: 999px;
}
#OnbProgress::chunk {
    background: #4F59C0;
    border-radius: 999px;
}

QLabel#ShelfBadge {
    color: #FFFFFF;
    background-color: #15803D;
    border: none;
    border-radius: 12px;
    padding: 0 10px;
    font-size: 11px;
    font-weight: 600;
}
#BtnSetCurrent {
    color: #333B83;
    background: #EEF0FB;
    border: 1px solid #C0C6EE;
    border-radius: 12px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 600;
    outline: none;
}
#BtnSetCurrent:hover {
    background: #4F59C0;
    color: #FFFFFF;
    border: 1px solid #4F59C0;
}
#BtnSetCurrent:pressed {
    background: #3F48A2;
    color: #FFFFFF;
    border: 1px solid #3F48A2;
}

#Toast {
    background: #222831;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 13px;
}
#UndoBtn {
    background: #4F59C0;
    color: #FFFFFF;
    border: none;
    padding: 6px 12px;
    border-radius: 7px;
    font-weight: 700;
    font-size: 13px;
}
#UndoBtn:hover {
    background: #3F48A2;
}

Line, QFrame[frameShape="4"] {
    background-color: #DDE2EA;
}

QScrollArea, QAbstractScrollArea {
    border: none;
}
QScrollBar:vertical {
    background: #F7F8FA;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #DDE2EA;
    border-radius: 999px;
    min-height: 36px;
}
QScrollBar::handle:vertical:hover { background: #C2CAD6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0; width: 0;
}
QScrollBar:horizontal {
    background: #F7F8FA;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #DDE2EA;
    border-radius: 999px;
    min-width: 36px;
}
QScrollBar::handle:horizontal:hover { background: #C2CAD6; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0; width: 0;
}

QProgressBar {
    background-color: #EEF1F5;
    border-radius: 999px;
    height: 8px;
    text-align: center;
    color: #4A5363;
    font-size: 12px;
}
QProgressBar::chunk { background-color: #4F59C0; border-radius: 999px; }

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    margin-top: 16px;
    padding: 12px;
}
QGroupBox::title {
    color: #333B48;
    font-weight: 600;
    subcontrol-origin: margin;
    left: 12px;
}

QScrollArea#VocabTableScroll {
    background: transparent;
    border: none;
}
QScrollArea#VocabTableScroll > QWidget {
    background: transparent;
}
QWidget#VocabScrollInner {
    background-color: #FFFFFF;
}
QWidget#VocabRow {
    background-color: #FFFFFF;
}
QWidget#VocabRow QWidget {
    background: transparent;
}

QWidget#VocabTableHeader {
    background-color: #EEF1F5;
    border-bottom: 1px solid #DDE2EA;
}

QWidget#CellFullText {
    background-color: #FFFFFF;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    padding: 4px;
}
QWidget#CellFullText QLabel {
    color: #15191F;
    background: transparent;
}

#BagChk {
    background: transparent;
    border: none;
}
#ZhuPanel {
    background: #F7F8FA;
    border: 1px dashed #DDE2EA;
    border-radius: 12px;
}
#QuoteNote {
    background: #FBF1DF;
    border: 1px solid #B45309;
    border-radius: 12px;
}
#DupGroup {
    border: 1px solid #DDE2EA;
    border-radius: 12px;
    background: #F7F8FA;
    padding: 12px 16px;
    margin-top: 8px;
}
#ToastUndo {
    background: #4F59C0;
    color: #FFFFFF;
    border: none;
    padding: 8px 12px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
}
#ToastUndo:hover {
    background: #3F48A2;
}

#Toast QLabel {
    color: #FFFFFF;
    font-size: 13px;
    background: transparent;
}

QWidget#CellFullText QLabel {
    font-size: 13px;
}

QLabel[size="xs"] { font-size: 12px; }
QLabel[size="sm"] { font-size: 13px; }
QLabel[size="base"] { font-size: 14px; }
QLabel[size="md"] { font-size: 16px; }
QLabel[size="lg"] { font-size: 18px; }
QLabel[size="xl"] { font-size: 20px; }
QLabel[size="2xl"] { font-size: 24px; }
QLabel[size="3xl"] { font-size: 30px; }
QLabel[size="4xl"] { font-size: 36px; }
QLabel[weight="regular"] { font-weight: 400; }
QLabel[weight="medium"] { font-weight: 500; }
QLabel[weight="semibold"] { font-weight: 600; }
QLabel[weight="bold"] { font-weight: 700; }
QLabel[tone="primary.50"] { color: #EEF0FB; }
QLabel[tone="primary.100"] { color: #DDE1F6; }
QLabel[tone="primary.200"] { color: #C0C6EE; }
QLabel[tone="primary.300"] { color: #9AA3E2; }
QLabel[tone="primary.400"] { color: #6F79D1; }
QLabel[tone="primary.500"] { color: #4F59C0; }
QLabel[tone="primary.600"] { color: #3F48A2; }
QLabel[tone="primary.700"] { color: #333B83; }
QLabel[tone="primary.800"] { color: #2B3169; }
QLabel[tone="primary.900"] { color: #232852; }
QLabel[tone="neutral.0"] { color: #FFFFFF; }
QLabel[tone="neutral.50"] { color: #F7F8FA; }
QLabel[tone="neutral.100"] { color: #EEF1F5; }
QLabel[tone="neutral.200"] { color: #DDE2EA; }
QLabel[tone="neutral.300"] { color: #C2CAD6; }
QLabel[tone="neutral.400"] { color: #9AA4B4; }
QLabel[tone="neutral.500"] { color: #6B7585; }
QLabel[tone="neutral.600"] { color: #4A5363; }
QLabel[tone="neutral.700"] { color: #333B48; }
QLabel[tone="neutral.800"] { color: #222831; }
QLabel[tone="neutral.900"] { color: #15191F; }
QLabel[tone="success"] { color: #15803D; }
QLabel[tone="success.bg"] { color: #E7F4EC; }
QLabel[tone="success.border"] { color: #B6E0C5; }
QLabel[tone="warning"] { color: #B45309; }
QLabel[tone="warning.bg"] { color: #FBF1DF; }
QLabel[tone="warning.border"] { color: #F0D6A8; }
QLabel[tone="error"] { color: #C0392B; }
QLabel[tone="error.bg"] { color: #FBEAE8; }
QLabel[tone="error.border"] { color: #F1C4BD; }
QLabel[tone="info"] { color: #3F48A2; }
QLabel[tone="info.bg"] { color: #ECEEF9; }
QLabel[tone="info.border"] { color: #C8CDEC; }
QLabel[tone="focus"] { color: #4F59C0; }
QLabel[tone="on.fill"] { color: #FFFFFF; }
QLabel[tone="on.fill.soft"] { color: rgba(255,255,255,0.90); }
QLabel[tone="on.fill.hint"] { color: rgba(255,255,255,0.85); }
QLabel[tone="on.fill.stats"] { color: rgba(255,255,255,0.92); }
QLabel[tone="on.fill.track"] { color: rgba(255,255,255,0.25); }
QLabel[mono="true"] { font-family: "Cascadia Code","JetBrains Mono",Consolas,monospace; }

QFrame#HLine { border: none; }
QFrame#HLine[tone="primary.50"] { background: #EEF0FB; }
QFrame#HLine[tone="primary.100"] { background: #DDE1F6; }
QFrame#HLine[tone="primary.200"] { background: #C0C6EE; }
QFrame#HLine[tone="primary.300"] { background: #9AA3E2; }
QFrame#HLine[tone="primary.400"] { background: #6F79D1; }
QFrame#HLine[tone="primary.500"] { background: #4F59C0; }
QFrame#HLine[tone="primary.600"] { background: #3F48A2; }
QFrame#HLine[tone="primary.700"] { background: #333B83; }
QFrame#HLine[tone="primary.800"] { background: #2B3169; }
QFrame#HLine[tone="primary.900"] { background: #232852; }
QFrame#HLine[tone="neutral.0"] { background: #FFFFFF; }
QFrame#HLine[tone="neutral.50"] { background: #F7F8FA; }
QFrame#HLine[tone="neutral.100"] { background: #EEF1F5; }
QFrame#HLine[tone="neutral.200"] { background: #DDE2EA; }
QFrame#HLine[tone="neutral.300"] { background: #C2CAD6; }
QFrame#HLine[tone="neutral.400"] { background: #9AA4B4; }
QFrame#HLine[tone="neutral.500"] { background: #6B7585; }
QFrame#HLine[tone="neutral.600"] { background: #4A5363; }
QFrame#HLine[tone="neutral.700"] { background: #333B48; }
QFrame#HLine[tone="neutral.800"] { background: #222831; }
QFrame#HLine[tone="neutral.900"] { background: #15191F; }
QFrame#HLine[tone="success"] { background: #15803D; }
QFrame#HLine[tone="success.bg"] { background: #E7F4EC; }
QFrame#HLine[tone="success.border"] { background: #B6E0C5; }
QFrame#HLine[tone="warning"] { background: #B45309; }
QFrame#HLine[tone="warning.bg"] { background: #FBF1DF; }
QFrame#HLine[tone="warning.border"] { background: #F0D6A8; }
QFrame#HLine[tone="error"] { background: #C0392B; }
QFrame#HLine[tone="error.bg"] { background: #FBEAE8; }
QFrame#HLine[tone="error.border"] { background: #F1C4BD; }
QFrame#HLine[tone="info"] { background: #3F48A2; }
QFrame#HLine[tone="info.bg"] { background: #ECEEF9; }
QFrame#HLine[tone="info.border"] { background: #C8CDEC; }
QFrame#HLine[tone="focus"] { background: #4F59C0; }
QFrame#HLine[tone="on.fill"] { background: #FFFFFF; }
QFrame#HLine[tone="on.fill.soft"] { background: rgba(255,255,255,0.90); }
QFrame#HLine[tone="on.fill.hint"] { background: rgba(255,255,255,0.85); }
QFrame#HLine[tone="on.fill.stats"] { background: rgba(255,255,255,0.92); }
QFrame#HLine[tone="on.fill.track"] { background: rgba(255,255,255,0.25); }

#NoBadge {
    background: #EEF1F5;
    color: #6B7585;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
}

#CardBasis {
    color: #333B83;
    background: #EEF0FB;
    border-radius: 999px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 700;
}

QFrame#AutoChip {
    background: #EEF1F5;
    border: none;
    border-radius: 10px;
}
#AutoChip QLabel {
    background: transparent;
    border: none;
    color: #6B7585;
    font-size: 12px;
    font-weight: 700;
}

QFrame#BagChk[locked="true"] QLabel#BagChkText {
    color: #9AA4B4;
    font-weight: 400;
}

#ModalIco {
    border-radius: 8px;
    font-size: 16px;
}
#ModalIco[tone="primary"] {
    background: #DDE1F6;
    color: #333B83;
}
#ModalIco[tone="warning"] {
    background: #FBF1DF;
    color: #B45309;
}

#MarkIco {
    background: #DDE1F6;
    color: #333B83;
    border-radius: 12px;
    font-size: 20px;
}
#DoneMark {
    background: #15803D;
    color: #FFFFFF;
    border-radius: 12px;
    font-size: 18px;
}

#Callout {
    font-size: 13px;
}
#Callout[radius="lg"] { border-radius: 12px; }
#Callout[radius="md"] { border-radius: 8px; }
#Callout[pad="roomy"] { padding: 12px 16px; }
#Callout[pad="tight"] { padding: 8px 12px; }
#Callout[kind="info"] {
    background: #ECEEF9;
    border: 1px solid #C8CDEC;
    color: #3F48A2;
}
#Callout[kind="warn"] {
    background: #FBF1DF;
    border: 1px solid #F0D6A8;
    color: #B45309;
}
#Callout[kind="ok"] {
    background: #E7F4EC;
    border: 1px solid #B6E0C5;
    color: #15803D;
}
#Callout[kind="neutral"] {
    background: #EEF1F5;
    border: 1px solid #DDE2EA;
    color: #4A5363;
}

#StepDot {
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
}
#StepDot[state="done"] {
    background: #15803D;
    color: #FFFFFF;
}
#StepDot[state="current"] {
    background: #4F59C0;
    color: #FFFFFF;
}
#StepDot[state="wait"] {
    background: #EEF1F5;
    color: #6B7585;
}

QProgressBar#TaskBar {
    background: #EEF1F5;
    border: none;
    border-radius: 999px;
    height: 10px;
}
QProgressBar#TaskBar::chunk {
    background: #4F59C0;
    border-radius: 999px;
}

QProgressBar#OnbBar {
    background: #DDE2EA;
    border: none;
    border-radius: 999px;
}
QProgressBar#OnbBar::chunk {
    border-radius: 999px;
    background: #DDE2EA;
}
QProgressBar#OnbBar[state="done"]::chunk {
    background: #15803D;
}
QProgressBar#OnbBar[state="active"]::chunk {
    background: #4F59C0;
}
QProgressBar#OnbBar[state="todo"]::chunk {
    background: #DDE2EA;
}

QRadioButton#SnapPoint {
    color: #15191F;
    font-size: 13px;
    font-weight: 600;
}
QRadioButton#SnapPoint:disabled {
    color: #9AA4B4;
}

#ActiveHint {
    color: #333B83;
    font-size: 13px;
    background: transparent;
    margin-top: 4px;
}

#PassBanner {
    color: #15803D;
    font-weight: 700;
    font-size: 16px;
    background: #E7F4EC;
    border-radius: 8px;
    padding: 16px;
}

QTextEdit#CheckEditor {
    background: #F7F8FA;
    border: 1px solid #DDE2EA;
    border-radius: 8px;
    padding: 12px;
    font-family: "Cascadia Code","JetBrains Mono",Consolas,monospace;
    font-size: 13px;
    color: #222831;
}
QTextEdit#CheckEditor:focus {
    border: 1px solid #4F59C0;
}

#CheckToast {
    background: #222831;
    color: #FFFFFF;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 13px;
}

#ChkReady, #ChkRun { background: transparent; }
QScrollArea#ProbScroll { border: none; background: transparent; }
QWidget#ProbScrollInner { background: transparent; }

QScrollArea#BookWordScroll {
    border: 1px solid #DDE2EA;
    border-radius: 12px;
    background: #FFFFFF;
}
QScrollArea#BookWordScroll > QWidget {
    background: #FFFFFF;
}

#SnapDot {
    background: #DDE2EA;
    border-radius: 999px;
    border: none;
}
#SnapDot[current="true"] {
    background: #15803D;
    border: 3px solid #E7F4EC;
}

#MetaChip {
    background: #EEF1F5;
    color: #333B48;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 12px;
}

#DictIco {
    border-radius: 8px;
    font-size: 12px;
}
#DictIco[tone="custom"] { background: #E7F4EC; }
#DictIco[tone="info"] { background: #ECEEF9; }
#DictLock {
    color: #6B7585;
    font-size: 12px;
}
#DictLock[ghost="true"] { color: transparent; }

#DropZone {
    background: #FFFFFF;
    border: 2px dashed #C2CAD6;
    border-radius: 12px;
}
#DropZone[hot="true"] {
    background: #EEF0FB;
    border: 2px dashed #4F59C0;
}
#DropZone QLabel { border: none; background: transparent; }

#ImportDetail {
    color: #4A5363;
    background: #F7F8FA;
    border-radius: 8px;
    padding: 12px;
    font-family: "Cascadia Code","JetBrains Mono",Consolas,monospace;
    font-size: 12px;
}

#NoticeBar {
    border-radius: 8px;
    padding: 12px 12px;
    font-size: 13px;
}
#NoticeBar[kind="warn"] {
    background: #FBF1DF;
    color: #B45309;
    border: 1px solid #DDE2EA;
}
#NoticeBar[kind="info"] {
    background: #EEF0FB;
    color: #333B83;
    border: 1px solid #C0C6EE;
}
#NoticeBar[kind="ok"] {
    background: #E7F4EC;
    color: #15803D;
    border: 1px solid #E7F4EC;
}

#ShelfName {
    color: #222831;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    border: none;
}
#ShelfRow[current="true"] #ShelfName {
    color: #333B83;
    font-weight: 700;
}
#ShelfStatus {
    color: #15803D;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    border: none;
    outline: none;
}

#BookChip #BcName {
    color: #222831;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}
#BookChip #BcName[muted="true"] {
    color: #6B7585;
}
#BookChip #BcGo {
    color: #6B7585;
    font-size: 12px;
    font-weight: 600;
    padding-left: 8px;
    margin-left: 4px;
    border-left: 1px solid #DDE2EA;
    background: transparent;
}
#BookChip:hover #BcGo, #BookChip[hover="true"] #BcGo {
    color: #3F48A2;
}
#BookChip #BcDot {
    border-radius: 999px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6F79D1, stop:1 #3F48A2);
    border: 3px solid #DDE1F6;
}
#BookChip #BcDot[muted="true"] {
    background: #C2CAD6;
    border: 3px solid #EEF1F5;
}

